# Copy to .env and fill in. NEVER commit .env.
DJANGO_DEBUG=true
SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_urlsafe(50))"
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
FRONTEND_URL=http://localhost:5174

# Google Identity Services web client ID (same value as VITE_GOOGLE_CLIENT_ID).
# The client SECRET is not needed: the backend only verifies ID tokens.
GOOGLE_CLIENT_ID=

# Seconds
JWT_ACCESS_TOKEN_LIFETIME=900
JWT_REFRESH_TOKEN_LIFETIME=604800

OSM_USER_AGENT=CityShield/2.0 (your-contact-email@example.com)

# ---------------------------------------------------------------- Supabase
# Leave everything below empty to use SQLite and local media folders.

# Database: Supabase dashboard -> Connect -> "Session pooler" connection string
# (works on IPv4 hosts; the direct connection is IPv6-only). Replace [YOUR-PASSWORD].
DATABASE_URL=
# Seconds to keep a DB connection open between requests. Leave 0 for `runserver`
# (it uses a thread per request, which would exhaust the pooler's 15 client slots);
# set e.g. 60 in production under gunicorn.
DB_CONN_MAX_AGE=0

# Storage: Supabase dashboard -> Storage -> S3 Configuration -> "New access key".
# Create two buckets: report-media (Public) and sos-videos (private).
SUPABASE_URL=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
# Region shown on the S3 Configuration page, e.g. ap-south-1
SUPABASE_S3_REGION=
SUPABASE_PUBLIC_BUCKET=report-media
SUPABASE_PRIVATE_BUCKET=sos-videos
